rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function inShop(shopId) {
      return request.auth != null && profile().shopId == shopId;
    }
    function isOwner(shopId) {
      return inShop(shopId) && profile().role == 'owner';
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Self-service sign-up: a signed-in user may create their OWN profile once,
      // with a valid role and a shopId. Owners generate a new shop; staff pass the
      // shop code they were given. Role and shopId are locked afterwards.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.shopId is string
        && request.resource.data.role in ['owner', 'staff'];
      // One-time self-heal: an account whose profile has no shopId yet may attach
      // one (becoming the owner of a new shop). An existing shopId can never change.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && !('shopId' in resource.data)
        && request.resource.data.shopId is string
        && request.resource.data.role == 'owner'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shopId', 'role', 'name']);
      allow delete: if false;
    }

    match /shops/{shopId} {
      allow read: if inShop(shopId);
      // An owner may create their own shop document during sign-up (their profile,
      // written first, already marks them owner of this shopId). Never editable after.
      allow create: if isOwner(shopId)
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if false;

      match /items/{itemId} {
        allow read: if inShop(shopId);
        allow create, delete: if isOwner(shopId);
        // Staff may only change stock levels (selling & receiving).
        // Only the owner can touch names and prices.
        allow update: if isOwner(shopId)
          || (inShop(shopId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockQty']));
      }

      match /sales/{saleId} {
        allow read, create: if inShop(shopId);
        // Sales are permanent. Nobody — not even the owner — can edit or
        // delete one from the app. That is the anti-theft guarantee.
        allow update, delete: if false;
      }

      match /movements/{id} {
        allow read, create: if inShop(shopId);
        allow update, delete: if false;
      }

      match /dayCloses/{date} {
        allow read, create: if inShop(shopId);
        // One report per day, locked once submitted.
        allow update, delete: if false;
      }
    }
  }
}
